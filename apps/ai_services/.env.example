# ==============================================================================
# ThinkWire AI Microservice - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in apps/ai_services/ before running the service:
#   cp .env.example .env
#
# DO NOT commit real API keys or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# Host interface to bind server (0.0.0.0 for Docker/all interfaces, 127.0.0.1 for local only)
HOST=0.0.0.0
# Port on which FastAPI / Uvicorn listens (default: 8000)
PORT=8000
# Application Environment: 'development', 'staging', or 'production'
ENVIRONMENT=development
# Logging verbosity: 'debug', 'info', 'warning', 'error'
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. LLM & Inference Provider API Keys
# ------------------------------------------------------------------------------
# OpenAI API Key (Required for GPT-4o test generation and text-embedding-3-small)
# Obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Selection
# Default for assessment generation & resume evaluation: gpt-4o (or gpt-4o-mini for low latency/cost)
OPENAI_MODEL_ASSESSMENT=gpt-4o
# Default embedding model for vector search (1536 dimensions, pgvector compatible): text-embedding-3-small
OPENAI_MODEL_EMBEDDING=text-embedding-3-small

# Hugging Face User Access Token (Optional: used for local/open-weight model downloads or HF Inference API)
# Obtain from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_token_here

# ------------------------------------------------------------------------------
# 3. Offline / Mock Mode (For Local Development without API Keys)
# ------------------------------------------------------------------------------
# Set to 'true' to enable deterministic offline inference simulations without consuming OpenAI credits.
# Set to 'false' (default) for live LLM inference.
MOCK_INFERENCE=false

# ------------------------------------------------------------------------------
# 4. Database & Vector Storage (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
# Asynchronous connection string for PostgreSQL via asyncpg
# Used for storing candidate vector embeddings and semantic similarity queries (<-> operator)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/thinkwire_db

# ------------------------------------------------------------------------------
# 5. Background Task Queue (Redis / BullMQ)
# ------------------------------------------------------------------------------
# Redis connection URI for handling asynchronous resume parsing jobs dispatched from Express API Gateway
REDIS_URL=redis://localhost:6379
