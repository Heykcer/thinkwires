{
  "name": "backend",
  "version": "1.0.0",
  "description": "ThinkWire Staffing & Solutions Core Backend API Gateway",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
