# ==============================================================================
# ThinkWire Backend API Gateway - Environment Configuration Template
# ==============================================================================
# Copy this template to '.env' inside 'apps/backend/' before running the server:
#   cp .env.example .env
#
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# Host interface to bind (0.0.0.0 for Docker containers, 127.0.0.1 or localhost for local dev)
HOST=0.0.0.0
# Port on which the Express HTTP server will listen (Default: 5000)
PORT=5000
# Node Environment: 'development', 'test', or 'production'
NODE_ENV=development
# Logging verbosity: 'debug', 'info', 'warn', 'error'
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
# PostgreSQL connection string: postgres://<user>:<password>@<host>:<port>/<dbname>
# Default matches Docker Compose service (thinkwire-postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/thinkwire_db
# Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_LOGGING=false

# ------------------------------------------------------------------------------
# 3. Redis Cache & Task Queue (BullMQ)
# ------------------------------------------------------------------------------
# Redis connection string for session caching, feature flags, and background job queues
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 4. AI Microservice Integration
# ------------------------------------------------------------------------------
# URL of the decoupled FastAPI Python microservice (apps/ai_services)
# Used for candidate screening test generation, resume scoring, and vector embeddings
AI_SERVICE_URL=http://localhost:8000
# AI Request Timeout in milliseconds (default: 10000ms = 10s)
AI_SERVICE_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 5. Authentication & JWT Security
# ------------------------------------------------------------------------------
# High-entropy secret key used for signing JSON Web Tokens (JWT)
# Generate a secure string in production using: openssl rand -base64 32
JWT_SECRET=supersecret_dev_jwt_key_replace_in_production_12345
# Access token expiration duration (e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN=7d
# Refresh token secret (optional, for token rotation)
JWT_REFRESH_SECRET=supersecret_refresh_jwt_key_replace_in_production_67890
JWT_REFRESH_EXPIRES_IN=30d

# ------------------------------------------------------------------------------
# 6. CORS & Frontend Origins
# ------------------------------------------------------------------------------
# Allowed origins for Cross-Origin Resource Sharing (comma-separated for multiples)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 7. Rate Limiting (Security & Anti-Abuse)
# ------------------------------------------------------------------------------
# Time window for rate limiting in milliseconds (default: 15 minutes = 900000ms)
RATE_LIMIT_WINDOW_MS=900000
# Max requests allowed per window per IP
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------------------------
# 8. External Integrations (Optional / Staging / Production)
# ------------------------------------------------------------------------------
# Stripe API Secret Key for client billing and invoice generation
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_key

# Transactional Email Provider (Resend or SendGrid) for candidate invite emails
RESEND_API_KEY=re_test_placeholder_key
EMAIL_FROM=no-reply@thinkwire.internal
