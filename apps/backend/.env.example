# Server & Environment
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug

# Databases
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thinkwire_db
MONGODB_URI=mongodb://localhost:27017/thinkwire_db
REDIS_URL=redis://localhost:6379

# Microservices
AI_SERVICE_URL=http://localhost:8000

# Auth & Security
JWT_SECRET=your_jwt_secret_min_32_chars_here
ALLOWED_ORIGINS=https://thinkwires.vercel.app,http://localhost:5173
# COOKIE_SAME_SITE=lax
INITIAL_SUPERADMIN_EMAIL=superadmin@thinkwires.com
INITIAL_SUPERADMIN_PASSWORD=ThinkWires@Admin2026!

# Email (Zoho Mail SMTP)
# For Zoho India (.in accounts): smtppro.zoho.in
# For Zoho Global (.com accounts): smtppro.zoho.com
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@thinkwires.com
SMTP_PASS=your_zoho_app_specific_password_here
# Note: In Zoho Mail, EMAIL_FROM must use the same address as SMTP_USER (or an authorized Zoho alias)
EMAIL_FROM="ThinkWires" <info@thinkwires.com>
RECRUITMENT_NOTIFICATION_EMAIL=hr@thinkwires.com
ADMIN_NOTIFICATION_EMAIL=info@thinkwires.com

# Global Inbound Email Routing
COMPANY_INFO_EMAIL=info@thinkwires.com
HR_REQUISITION_EMAIL=hr@thinkwires.com
# OVERRIDE_NOTIFICATION_EMAIL=websiteadmin@thinkwires.com