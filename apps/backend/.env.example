# Server & Environment
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug

# Databases
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thinkwire_db
MONGODB_URI=mongodb://localhost:27017/thinkwire_db
REDIS_URL=redis://localhost:6379

# Microservices
AI_SERVICE_URL=http://localhost:8000

# Auth & Security
JWT_SECRET=your_jwt_secret_min_32_chars_here
ALLOWED_ORIGINS=https://thinkwires.vercel.app,http://localhost:5173
# COOKIE_SAME_SITE=lax
INITIAL_SUPERADMIN_EMAIL=superadmin@thinkwires.com
INITIAL_SUPERADMIN_PASSWORD=ThinkWires@Admin2026!

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=careers@thinkwires.com
SMTP_PASS=your_smtp_app_password_here
SMTP_SECURE=false
EMAIL_FROM="ThinkWires Recruitment" <careers@thinkwires.com>
RECRUITMENT_NOTIFICATION_EMAIL=recruitment@thinkwires.com
ADMIN_NOTIFICATION_EMAIL=admin@thinkwires.com