# Server & Ports
PORT=5000
NODE_ENV=development
FRONTEND_PORT=5173
AI_SERVICE_PORT=8000

# Databases
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thinkwire_db
MONGODB_URI=mongodb://localhost:27017/thinkwire_db
REDIS_URL=redis://localhost:6379

# Auth & Security
JWT_SECRET=your_jwt_secret_min_32_chars_here
ALLOWED_ORIGINS=https://thinkwires.vercel.app,http://localhost:5173
# COOKIE_SAME_SITE=lax
INITIAL_SUPERADMIN_EMAIL=superadmin@thinkwires.com
INITIAL_SUPERADMIN_PASSWORD=ThinkWires@Admin2026!

# AI Services & Free LLM Cascade (Groq -> Gemini -> OpenRouter -> Ollama -> Fallback)
AI_SERVICE_URL=http://localhost:8000
PRIMARY_LLM_PROVIDER=auto
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=careers@thinkwires.com
SMTP_PASS=your_smtp_app_password_here
SMTP_SECURE=false
EMAIL_FROM="ThinkWires Recruitment" <careers@thinkwires.com>
RECRUITMENT_NOTIFICATION_EMAIL=recruitment@thinkwires.com
ADMIN_NOTIFICATION_EMAIL=admin@thinkwires.com

# Frontend
VITE_API_URL=http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_NAME=ThinkWires
VITE_APP_ENV=development
