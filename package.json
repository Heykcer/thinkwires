{
  "name": "thinkwires",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "packageManager": "npm@11.7.0",
  "scripts": {
    "start": "npm --prefix apps/backend start",
    "build": "npm run build:frontend",
    "build:frontend": "npm --prefix apps/frontend run build",
    "build:backend": "npm --prefix apps/backend run build",
    "vercel-build": "npm run build:frontend",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm --prefix apps/backend run dev\" \"npm --prefix apps/frontend run dev\"",
    "dev:all": "concurrently -n backend,frontend,ai -c blue,green,magenta \"npm --prefix apps/backend run dev\" \"npm --prefix apps/frontend run dev\" \"npm --prefix apps/ai_services run dev\"",
    "dev:backend": "npm --prefix apps/backend run dev",
    "dev:frontend": "npm --prefix apps/frontend run dev",
    "dev:ai": "npm --prefix apps/ai_services run dev",
    "seed": "npm --prefix apps/backend run seed",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm --prefix apps/backend run test:unit",
    "test:e2e": "npm --prefix apps/frontend run test:e2e",
    "test:system": "npm --prefix apps/backend run test:system",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "npm --prefix apps/backend run migrate",
    "migrate:status": "npm --prefix apps/backend run migrate:status",
    "migrate:down": "npm --prefix apps/backend run migrate:down",
    "setup": "npm install && npm run install:requirements",
    "install:all": "npm install && npm run install:requirements",
    "install:requirements": "npm --prefix apps/ai_services run setup",
    "install:python": "npm run install:requirements",
    "install:frontend": "npm --prefix apps/frontend install",
    "install:backend": "npm --prefix apps/backend install",
    "install:ai": "npm run install:requirements",
    "setup:ai": "npm --prefix apps/ai_services run setup",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.8.12",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.6",
    "nodemon": "^3.1.14",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "redis": "^6.3.0",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.9.9"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.2.11",
    "@rolldown/binding-darwin-x64": "^1.2.11",
    "@rolldown/binding-linux-arm64-gnu": "^1.2.11",
    "@rolldown/binding-linux-x64-gnu": "^1.2.11",
    "@rolldown/binding-win32-x64-msvc": "^1.2.11",
    "lightningcss-darwin-arm64": "^1.33.0",
    "lightningcss-darwin-x64": "^1.33.0",
    "lightningcss-linux-arm64-gnu": "^1.33.0",
    "lightningcss-linux-x64-gnu": "^1.33.0",
    "lightningcss-win32-x64-msvc": "^1.33.0"
  }
}
