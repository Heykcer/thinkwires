{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix apps/frontend run build",
  "outputDirectory": "apps/frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://thinkwires.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://thinkwires.onrender.com/uploads/:path*"
    },
    {
      "source": "/health",
      "destination": "https://thinkwires.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

